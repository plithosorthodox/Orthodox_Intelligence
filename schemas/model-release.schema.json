{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://orthodox-intelligence.local/schema/model-release.v0.1.json",
  "title": "OI Model Release Manifest v0.1",
  "description": "The immutable identity and evidence pointers for an evaluated OI candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "release_id",
    "status",
    "created_utc",
    "application",
    "model",
    "substrate",
    "elf",
    "corpus",
    "retriever",
    "verifier",
    "evaluation",
    "acceptance_criteria_version"
  ],
  "properties": {
    "release_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["research_candidate", "review_candidate", "release_approved", "withdrawn"]},
    "created_utc": {"type": "string", "format": "date-time"},
    "application": {"$ref": "#/$defs/component"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_model_id", "license_id", "weights_sha256", "tokenizer_sha256", "quantization", "runtime"],
      "properties": {
        "base_model_id": {"type": "string", "minLength": 1},
        "base_revision": {"type": ["string", "null"]},
        "license_id": {"type": "string", "minLength": 1},
        "weights_sha256": {"$ref": "#/$defs/sha256"},
        "tokenizer_sha256": {"$ref": "#/$defs/sha256"},
        "quantization": {"type": "string", "minLength": 1},
        "runtime": {"$ref": "#/$defs/component"}
      }
    },
    "substrate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "training_manifest_sha256"],
      "properties": {
        "condition": {"type": "string", "enum": ["S0", "S1"]},
        "training_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "elf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "version", "content_sha256", "review_status"],
      "properties": {
        "condition": {"type": "string", "enum": ["E0", "E1"]},
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"},
        "review_status": {"type": "string", "minLength": 1}
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "export_id", "manifest_sha256", "index_sha256"],
      "properties": {
        "condition": {"type": "string", "enum": ["R0", "R1"]},
        "export_id": {"type": "string", "minLength": 1},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "index_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "retriever": {"$ref": "#/$defs/component"},
    "verifier": {"$ref": "#/$defs/component"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol_version", "report_sha256", "passed"],
      "properties": {
        "protocol_version": {"type": "string", "minLength": 1},
        "report_sha256": {"$ref": "#/$defs/sha256"},
        "passed": {"type": "boolean"}
      }
    },
    "acceptance_criteria_version": {"type": "string", "minLength": 1},
    "target_devices": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "approvals": {"type": "array", "items": {"type": "object"}},
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "content_sha256"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}

