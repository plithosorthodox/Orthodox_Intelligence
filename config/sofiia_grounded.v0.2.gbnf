# Grammar for the sofiia-grounded-json-v0.2 contract.
#
# v0.2 makes claim-to-source linkage structural: every answer is one to three
# claim objects, and every claim carries its own short evidence references.
# Shape is constrained here; source membership and quotations are still
# checked deterministically after generation.
#
# Keep every rule on one line. llama.cpp ends a GBNF rule at the newline.

root ::= "{" ws "\"answer\":" ws claims "," ws "\"quotes\":" ws quotes "," ws "\"abstain\":" ws boolean "}" ws
claims ::= "[" ws claim ("," ws claim ("," ws claim)?)? "]" ws
claim ::= "{" ws "\"text\":" ws string "," ws "\"citations\":" ws idarray "}" ws
idarray ::= "[" ws ( string ("," ws string)* )? "]" ws
quotes ::= "[" ws ( qitem ("," ws qitem)* )? "]" ws
qitem ::= "{" ws "\"segment_id\":" ws string "," ws "\"text\":" ws string "}" ws
boolean ::= ("true" | "false") ws
string ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" (["\\bfnrt] | "u" [0-9a-fA-F]{4}) )* "\"" ws
ws ::= | " " | "\n" [ \t]{0,20}
